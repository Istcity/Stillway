    "onboard_3_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stillway accompanies your day — soft soundscapes, living ambient light, and zero rush."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stillway accompagne vos journées — acoustique bienveillante, lueurs douces, loin de toute urgence."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stillwayはあなたに寄り添います。優しいアコースティックサウンドと光、急かすことのない安らぎ。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stillway her an yanınızda — yumuşak akustik sesler, nefes alan ışık, aceleden uzak bir huzur."
          }
        }
      }
    },
