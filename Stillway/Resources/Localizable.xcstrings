    "onboard_body1" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It understands where you are and what you’re doing. The right sound starts without you choosing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il comprend où vous êtes et ce que vous faites. Le bon son démarre sans que vous choisissiez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこにいて、何をしているかを理解します。選ばなくても、正しい音が始まります。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nerede olduğunu, ne yaptığını anlıyor. Sen hiçbir şey seçmeden doğru müziği açıyor."
          }
        }
      }
    },
    "onboard_body2" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you put in AirPods and approach a station, Stillway starts on its own."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous mettez vos AirPods et approchez d’une station, Stillway démarre tout seul."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPodsをつけて駅に近づくと、Stillwayが自動で始まります。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods'unu taktığında ve bir durağa yaklaştığında Stillway otomatik olarak başlar."
          }
        }
      }
    },
    "onboard_body3" : {
      "extractionState" : "stale",
