    "privacy_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stillway is 100% on-device. No user accounts, no telemetry, and no advertisements. Your stillness is strictly private."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stillway fonctionne entièrement sur votre appareil. Aucun compte utilisateur, aucune télémétrie, aucune publicité. Votre sérénité vous appartient en toute exclusivité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stillwayは完全に端末内で動作します。アカウント登録、追跡、広告は一切ありません。あなたの静寂は完全に守られています。"
          }
        },
        "tr" : {
