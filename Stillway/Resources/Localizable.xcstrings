    "onboard_1_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It understands where you are and what you're doing. The ideal acoustic atmosphere starts without you needing to tap a screen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application perçoit vos déplacements et votre quotidien. La bonne atmosphère sonore démarre sans aucune manipulation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたがどこにいて、今何をしているかを理解します。画面を操作しなくても、最適なアンビエントが自動で流れます。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nerede olduğunuzu ve anlık ritminizi sezgisel olarak anlar. Sizin hiçbir şeye dokunmanıza gerek kalmadan doğru ambient atmosferi başlatır."
          }
        }
      }
    },
