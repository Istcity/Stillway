<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Stillway</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.sinannergiz.stillway</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>stillway</string>
			</array>
		</dict>
	</array>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Stillway uses your location in the background to recognize stations and places you visit, so the right sound can start without opening the app.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Stillway uses your location to detect nearby transit stops and the places you return to.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Stillway needs always-on location so commute and sleep modes can start while the app is closed.</string>
	<key>NSMotionUsageDescription</key>
	<string>Stillway reads motion to tell walking, transit, and rest apart — never sent off the device.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
		<string>fetch</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>NSHealthShareUsageDescription</key>
	<string>Stillway synchronizes mindful sessions with Apple Health.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Stillway saves completed focus and rest sessions as Mindful Minutes in Apple Health.</string>
</dict>
</plist>
